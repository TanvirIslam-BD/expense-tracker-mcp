# Copy to .env for local development (values shown are the defaults).

# Transport: "http" or "stdio". If unset, the server picks http when PORT is
# present (as it is on MCPize / Cloud Run) and stdio otherwise.
# MCP_TRANSPORT=stdio

# HTTP port (MCPize / Cloud Run set this automatically).
# PORT=8080

# Default ISO-4217 currency used when an expense omits one.
DEFAULT_CURRENCY=USD

# Durable storage (recommended for any hosted/production deployment). If set,
# expenses and budgets are stored in a libSQL/Turso database instead of
# in-memory, so data survives restarts and is shared across instances.
# Get a free database at https://turso.tech — see README's "Storage &
# persistence" section for exact steps. Works with a local file too:
# TURSO_DATABASE_URL=file:./data/local.db
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io?authToken=<token>
# TURSO_AUTH_TOKEN=   # only needed if not embedding the token above

# Optional: directory for JSON persistence with the fallback in-memory store.
# Ignored if TURSO_DATABASE_URL is set. Data is in-memory only if both are
# unset (lost on restart) — fine for local dev, NOT for production hosting.
# DATA_DIR=./data

# Fallback user id for stdio / unauthenticated requests. In HTTP mode each
# subscriber is isolated automatically from their auth header.
# DEFAULT_USER_ID=local

# Optional budget-limit email delivery. Configure a Resend API key and a
# verified sender address, then users can enable their own recipient with the
# `set_budget_email_alert` MCP tool.
# RESEND_API_KEY=re_...
# BUDGET_ALERT_EMAIL_FROM="Money Copilot AI <alerts@example.com>"
# PUBLIC_BASE_URL=https://your-mcp-domain.example
# BUDGET_ALERT_HERO_URL=https://your-mcp-domain.example/assets/email/budget-alert-hero.png
# Public web app opened by Review Spending / Open Money Copilot AI buttons.
# EXPENSE_TRACKER_WEB_URL=https://www.copilotai.live/
# Optional explicit destination for signed private dashboard links.
# DASHBOARD_WEB_URL=https://www.copilotai.live
# Alert-email artwork is embedded directly in the message (CID attachments) by
# default, because hosted /assets URLs sit behind the MCPize gateway's auth and
# return 401 to the unauthenticated fetch mail clients make — which shows the
# recipient broken images. Only set this to false if /assets is publicly served.
# EMAIL_INLINE_HERO=false

# Required for one-click private /dashboard links generated by the
# get_dashboard_link MCP tool. Use a long, random secret and add the same value
# to your MCPize deployment secrets; do not commit a real value.
# DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret
