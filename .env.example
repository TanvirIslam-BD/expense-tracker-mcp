# Copy to .env for local development (values shown are the defaults).

# Transport: "http" or "stdio". If unset, the server picks http when PORT is
# present (as it is on MCPize / Cloud Run) and stdio otherwise.
# MCP_TRANSPORT=stdio

# HTTP port (MCPize / Cloud Run set this automatically).
# PORT=8080

# Default ISO-4217 currency used when an expense omits one.
DEFAULT_CURRENCY=USD

# Durable storage (recommended for any hosted/production deployment). If set,
# expenses and budgets are stored in a libSQL/Turso database instead of
# in-memory, so data survives restarts and is shared across instances.
# Get a free database at https://turso.tech — see README's "Storage &
# persistence" section for exact steps. Works with a local file too:
# TURSO_DATABASE_URL=file:./data/local.db
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io?authToken=<token>
# TURSO_AUTH_TOKEN=   # only needed if not embedding the token above

# Optional: directory for JSON persistence with the fallback in-memory store.
# Ignored if TURSO_DATABASE_URL is set. Data is in-memory only if both are
# unset (lost on restart) — fine for local dev, NOT for production hosting.
# DATA_DIR=./data

# Fallback user id for stdio / unauthenticated requests. In HTTP mode each
# subscriber is isolated automatically from their auth header.
# DEFAULT_USER_ID=local
