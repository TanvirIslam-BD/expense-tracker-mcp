# Copy to .env for local development (values shown are the defaults).

# Transport: "http" or "stdio". If unset, the server picks http when PORT is
# present (as it is on MCPize / Cloud Run) and stdio otherwise.
# MCP_TRANSPORT=stdio

# HTTP port (MCPize / Cloud Run set this automatically).
# PORT=8080

# Default ISO-4217 currency used when an expense omits one.
DEFAULT_CURRENCY=USD

# Optional: directory for JSON persistence. If unset, data is in-memory only
# (lost on restart). On Cloud Run the filesystem is ephemeral per instance —
# for durable multi-instance storage, plug in a real database (see README).
# DATA_DIR=./data

# Fallback user id for stdio / unauthenticated requests. In HTTP mode each
# subscriber is isolated automatically from their auth header.
# DEFAULT_USER_ID=local
