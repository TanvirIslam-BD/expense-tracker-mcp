{
  "name": "expense-tracker-mcp",
  "version": "1.0.0",
  "description": "Personal expense tracker MCP server — record expenses, set monthly budgets, and generate spending summaries. Built for the MCPize marketplace (TypeScript SDK).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "bin": {
    "expense-tracker-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "npm run build && node dist/index.js --stdio",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js --stdio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "expense-tracker",
    "budget",
    "finance",
    "mcpize"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
